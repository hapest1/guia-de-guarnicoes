rules_version = '2';
// Regras do Firestore para o Missão Idiomas.
// Cole em: Console do Firebase > Firestore Database > Regras > Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{uid} {
      // Qualquer usuário logado vê o ranking (nome, posto, OM, XP e perfil SLP).
      allow read: if request.auth != null;
      // Cada um só cria e altera o próprio perfil, com campos básicos válidos.
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 24
        && request.resource.data.xp is int && request.resource.data.xp >= 0
        && request.resource.data.xpSemana is int && request.resource.data.xpSemana >= 0;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
