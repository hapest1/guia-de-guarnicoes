{
  "name": "guia-de-guarnicoes-app",
  "version": "1.0.0",
  "private": true,
  "description": "App iOS do Guia de Guarnições (Capacitor), gerado a partir do site estático.",
  "scripts": {
    "build": "node scripts/build-www.mjs",
    "sync": "npm run build && npx cap sync ios",
    "assets": "npx capacitor-assets generate --ios --iconBackgroundColor '#2C5A37' --splashBackgroundColor '#ECEFE7' --splashBackgroundColorDark '#11150F'"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.4.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2"
  }
}
